# OpenRouter API key, used by pipeline/jev.js for Jev AI structured decisions
OPENROUTER_API_KEY=
# OpenRouter model slug for Jev AI (cheap structured decisions, §8 of docs/spec.md)
JEV_MODEL=typesafe/jev-1.13
# Unsplash access key, used by scripts/search-images.js / download-image.js
UNSPLASH_ACCESS_KEY=
# Unsplash application ID (dashboard identifier, not required for API calls)
UNSPLASH_APPLICATION_ID=
# Unsplash secret key (dashboard identifier, not required for API calls)
UNSPLASH_SECRET_KEY=
# Port the local teleprompter/review app (app/server.js) listens on
APP_PORT=4310
# Whisper model size used by whisper_timestamps.py / pipeline/whisper.js
WHISPER_MODEL=turbo
# TTS voice for `node pipeline/cli.js tts` (OpenRouter /api/v1/audio/speech; also uses OPENROUTER_API_KEY above).
# Defaults live in config/tts.json. Leave these empty unless you want a global override:
# a flag or script.md frontmatter (tts_model / tts_voice / tts_speed) wins over them.
TTS_MODEL=
# No default voice on purpose: the creator names one per video (--voice=<name> or `tts_voice:` in script.md).
TTS_VOICE=
# Tempo (ffmpeg atempo, pitch kept). Empty = config/tts.json default 1.15.
TTS_SPEED=
