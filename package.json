{
  "name": "reelsmith",
  "version": "0.1.0",
  "description": "Script in, short out. A plugin-based framework for agent-made short videos.",
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/Aabishkar2/reelsmith.git" },
  "homepage": "https://github.com/Aabishkar2/reelsmith#readme",
  "bugs": { "url": "https://github.com/Aabishkar2/reelsmith/issues" },
  "keywords": ["video", "shorts", "tts", "whisper", "subtitles", "motion-graphics", "claude-code", "agent"],
  "engines": { "node": ">=18" },
  "bin": { "reelsmith": "bin/reelsmith.js" },
  "files": [
    "bin/",
    "core/",
    "pipeline/*.js",
    "pipeline/*.py",
    "renderer/",
    "runtime/",
    "tools/",
    "app/",
    "plugins/",
    "styles/",
    "skills/",
    "templates/",
    "config/fillers.json",
    "config/audio.md",
    "config/music.md",
    "config/voice/",
    "music/CREDITS.md",
    "music/download.sh",
    "docs/",
    "whisper_timestamps.py",
    ".env.example",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test": "node pipeline/test/run-tests.js",
    "app": "node app/server.js"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "playwright": "^1.52.0"
  }
}
