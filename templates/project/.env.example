# Reelsmith keys and overrides. Copy to .env (never commit .env). Every line is optional unless noted;
# `reelsmith doctor` shows what is set and what is missing.

# --- TTS (reelsmith tts) ---
# OpenRouter API key for TTS voices and Jev decisions. Needed only to generate new TTS audio (https://openrouter.ai/keys).
OPENROUTER_API_KEY=
# Override the TTS model (default reelsmith.config.json tts.model = google/gemini-3.8-flash-tts; a flag or tts_model: wins).
TTS_MODEL=
# Global TTS voice. Leave empty: there is no default on purpose, the creator names one per video (--voice= or tts_voice:).
TTS_VOICE=
# TTS tempo, 0.5-2 (default 1.15; ffmpeg atempo, applied locally, never re-calls the API).
TTS_SPEED=
# TTS mode: sentence (one call per line) or performance (the whole script in one call). Default: tts.mode.
TTS_MODE=

# --- Word timings, tools ---
# Whisper model for word timings (tiny, base, small, medium, large, turbo). Default: stt.model = turbo.
WHISPER_MODEL=
# Python with openai-whisper installed. Default: the first of python3.11, python3.12, python3.13, python3 that works.
REELSMITH_PYTHON=
# ffmpeg to use (a path or command name). Default: PATH, then /opt/homebrew/bin and /usr/local/bin. ffprobe: FFPROBE_PATH.
FFMPEG_PATH=
# Port of the teleprompter app (reelsmith record). Default: reelsmith.config.json app.port = 4310.
APP_PORT=
# Jev AI model slug on OpenRouter (cheap filler decisions during take analysis).
JEV_MODEL=typesafe/jev-1.13

# --- Publishing (reelsmith publish; all optional) ---
# Folder for publish credentials such as the YouTube OAuth client + token. Default: ~/.config/reelsmith.
REELSMITH_CONFIG_DIR=
# YouTube OAuth client JSON (Desktop app). Default: <REELSMITH_CONFIG_DIR>/youtube-client.json. Then: reelsmith publish <video> --to=youtube --auth
YOUTUBE_CLIENT_FILE=
# Meta Graph API system-user token that may post to the page and its Instagram account (Facebook + Instagram Reels).
META_SYSTEM_TOKEN=
# Facebook Page id the reel is posted to.
META_PAGE_ID=
# Instagram business account id linked to that page (Instagram also needs a public URL of the mp4: --public-url=).
META_IG_USER_ID=
# Discord bot token (the bot needs Send Messages + Attach Files in the channel).
DISCORD_BOT_TOKEN=
# Discord channel id the video is posted to (reelsmith.config.json publish.targets.discord.channelIdEnv may name another variable).
DISCORD_CHANNEL_ID=

# --- Images (tools/search-images.js, tools/download-image.js) ---
# Unsplash access key for image search (optional; Wikimedia needs none).
UNSPLASH_ACCESS_KEY=
# Pexels API key for image search (optional).
PEXELS_API_KEY=
